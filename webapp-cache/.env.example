# ── D365 / Azure AD credentials ──────────────────────────────────────────
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
D365_ENV_URL=https://your-env.operations.dynamics.com
D365_COMPANY_ID=your-company-id

# ── Flask ────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=generate-a-long-random-string-here

# ── Azure Automation (for report dispatch) ───────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=Daily_Invoiced_Report
AZURE_AUTOMATION_ACCOUNT=DailyInvoicedReport
AZURE_RUNBOOK_NAME=universal_runbook

# ── SharePoint (for downloading finished reports) ────────────────────────
SHAREPOINT_SITE_NAME=AchimImportingCoInc
WEBAPP_PICKUP_FOLDER=D365 F&O/webapp_reports

# ── Background refresh ──────────────────────────────────────────────────
# How often to refresh caches from D365 (in seconds). Default: 3600 (1 hour)
REFRESH_INTERVAL_SECONDS=3600

# ── Optional ─────────────────────────────────────────────────────────────
# Set to 1 to skip Azure AD login locally (uses a dev bypass user)
# DEV_BYPASS_AUTH=1

# Google Maps API key for address autocomplete (optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
