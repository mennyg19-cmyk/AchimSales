# v3 Sales Reports - environment template. Copy to .env for local dev.
# NEVER commit a real .env. All secrets live in Azure App Settings in production.

# --- Runtime mode ---
# APP_ENV: "dev" (local) or "prod" (Azure). DEFAULT IS "prod" (fail closed): if you
# forget to set it, the app refuses to boot rather than silently running dev auth.
# For local development you MUST set it to "dev" explicitly.
APP_ENV=dev

# AUTH_MODE: "dev" (no real login, local only) or "msal" (Entra ID).
# AUTH_MODE=dev is rejected when APP_ENV=prod.
AUTH_MODE=dev

# Flask session signing key. MUST be set to a strong random value in prod.
# A default/empty value is rejected when APP_ENV=prod.
FLASK_SECRET=

# --- Entra ID / MSAL (required when AUTH_MODE=msal) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Reporting API (on-prem, via Hybrid Connection) ---
REPORTING_API_BASE_URL=
REPORTING_API_KEY=

# --- Data layer ---
# Local disk paths only. UNC/SMB (Azure Files, \\server\\share, //share) is REJECTED
# in prod. Litestream replicates the home-site precious file to Blob.
# Home site (is_beta=True): SITE_PRECIOUS_DB_PATH, alias BETA_PRECIOUS_DB_PATH.
# SITE_PRECIOUS_DB_PATH=./.data/beta_precious.db
# BETA_PRECIOUS_DB_PATH=./.data/beta_precious.db
# SITE_CACHE_DB_PATH=./.data/beta_cache.db
# Leftover /test names (not used by home-site WSGI):
PRECIOUS_DB_PATH=./.data/precious.db
CACHE_DB_PATH=./.data/cache.db

# --- Litestream ---
# REQUIRED in prod. startup.sh uses these Azure settings (not LITESTREAM_BLOB_URL).
# Leave blank for local APP_ENV=dev.
LITESTREAM_AZURE_ACCOUNT_NAME=
LITESTREAM_AZURE_ACCOUNT_KEY=
LITESTREAM_AZURE_CONTAINER=
LITESTREAM_AZURE_SITE_PATH=
# LITESTREAM_AZURE_BETA_PATH=   # alias until Azure is renamed
# LITESTREAM_AZURE_PATH=        # leftover /test replica; not used by home-site boot
# LITESTREAM_BLOB_URL=   # unused by startup.sh; do not rely on this for boot

# --- Delivery (optional locally; prod uses Graph via GRAPH_* + EMAIL_FROM_ADDRESS) ---
# Outbox .eml always written. Graph preferred when GRAPH_* + EMAIL_FROM[_ADDRESS] set.
# SMTP is the fallback when SMTP_HOST is set and Graph isn't.
# EMAIL_FROM=
# EMAIL_FROM_ADDRESS=reports@achimonline.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
# OUTBOX_DIR=./.data/outbox
