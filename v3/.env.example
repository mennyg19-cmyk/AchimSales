# v3 Sales Reports - environment template. Copy to .env for local dev.
# NEVER commit a real .env. All secrets live in Azure App Settings in production.

# --- Runtime mode ---
# APP_ENV: "dev" (local) or "prod" (Azure). DEFAULT IS "prod" (fail closed): if you
# forget to set it, the app refuses to boot rather than silently running dev auth.
# For local development you MUST set it to "dev" explicitly.
APP_ENV=dev

# AUTH_MODE: "dev" (no real login, local only) or "msal" (Entra ID).
# AUTH_MODE=dev is rejected when APP_ENV=prod.
AUTH_MODE=dev

# Flask session signing key. MUST be set to a strong random value in prod.
# A default/empty value is rejected when APP_ENV=prod.
FLASK_SECRET=

# --- Entra ID / MSAL (required when AUTH_MODE=msal) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Reporting API (on-prem, via Hybrid Connection) ---
REPORTING_API_BASE_URL=
REPORTING_API_KEY=

# --- Data layer ---
# Local disk paths only. UNC/SMB (Azure Files, \\server\share, //share) is REJECTED
# in prod. Litestream replicates PRECIOUS_DB to Blob.
PRECIOUS_DB_PATH=./.data/precious.db
CACHE_DB_PATH=./.data/cache.db

# --- Litestream ---
# REQUIRED in prod (precious.db durability). Leave blank for local dev.
LITESTREAM_BLOB_URL=

# --- Feature flags ---
NEW_APP_MARKER=1
