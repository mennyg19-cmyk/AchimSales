# Canonical home-site local template: v3/.env.example.
# This root file also lists Azure App Service dispatcher, legacy, and Litestream settings.
# Use placeholders only; set real production values in Azure App Settings.

# D365 Finance & Operations CLI/runbook settings
D365_ENV_URL=https://your-org.operations.dynamics.com
D365_COMPANY_ID=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=

# Azure AD / MSAL and Reporting API
APP_ENV=dev
AUTH_MODE=dev
FLASK_SECRET=
FLASK_SECRET_KEY=
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
REPORTING_API_BASE_URL=
REPORTING_API_KEY=
REPORTING_API_TIMEOUT_SECONDS=300

# SQLite paths (SITE_* is preferred for the home site)
SITE_PRECIOUS_DB_PATH=./.data/precious.db
SITE_CACHE_DB_PATH=./.data/cache.db
PRECIOUS_DB_PATH=./.data/precious.db
CACHE_DB_PATH=./.data/cache.db
BETA_PRECIOUS_DB_PATH=./.data/beta_precious.db
BETA_CACHE_DB_PATH=./.data/beta_cache.db

# Litestream Azure Blob
LITESTREAM_BLOB_URL=
LITESTREAM_AZURE_ACCOUNT_NAME=
LITESTREAM_AZURE_ACCOUNT_KEY=
LITESTREAM_AZURE_CONTAINER=
LITESTREAM_AZURE_PATH=
LITESTREAM_AZURE_BETA_PATH=
# LITESTREAM_VERSION=v0.3.13

# SharePoint and delivery
SP_SITE_URL=https://your-org.sharepoint.com/sites/your-site
DriveRootPath=D365 F&O
EMAIL_FROM=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
OUTBOX_DIR=./.data/outbox
PUBLIC_BASE_URL=https://reports.achimonline.com
DEV_BYPASS_AUTH=0
DASHBOARD_REFRESH_ENABLED=1
NEW_APP_MARKER=1

# Dispatcher mounts and Gunicorn
V3_MOUNT_ENABLED=1
BETA_MOUNT_ENABLED=1
REBUILD_MOUNT_ENABLED=0
V3_URL_PREFIX=/test
BETA_URL_PREFIX=/beta
LEGACY_URL_PREFIX=/legacy
REBUILD_MOUNT_PATH=/test-next
WEB_CONCURRENCY=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=230
PORT=8000
V3_ADMIN_EMAILS=
V3_DEVELOPER_EMAILS=

# CLI/runbook delivery and alerts
AMAZON_EMAIL_FROM=
AMAZON_EMAIL_RECIPIENTS=
ALERT_RECIPIENTS=

# PARITY_* tools are archive-only. Never place production session cookies in .env.
