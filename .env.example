# D365 Finance & Operations (CLI / Azure Automation)
D365_ENV_URL=https://your-org.operations.dynamics.com
D365_COMPANY_ID=

# Azure AD / MSAL (client credentials)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# SharePoint (for runbook upload)
SP_SITE_URL=https://your-org.sharepoint.com/sites/your-site
DriveRootPath=D365 F&O

# Email for customer-filtered Ordered --email runs (optional)
# AMAZON_EMAIL_RECIPIENTS=user1@company.com,user2@company.com

# Option A: Microsoft Graph (recommended for business; no app password)
# Uses same GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET. App needs Mail.Send + admin consent.
# AMAZON_EMAIL_FROM=reports@company.com

# Option B: SMTP (e.g. if Graph not set up)
# SMTP_USER=reports@company.com
# SMTP_PASSWORD=your-app-password
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# Alerting (runbook failure / warning notifications)
# Comma-separated list of admin email addresses. If empty, alerts are logged only.
# ALERT_RECIPIENTS=admin@company.com,ops@company.com

# Home-site Flask app (Azure App Service / gunicorn wsgi:application):
# copy every required setting from v3/.env.example. That file is the canonical
# web template (APP_ENV, AUTH_MODE, FLASK_SECRET, Reporting API, SITE_* DB
# paths, Litestream, Graph mail). Do not invent a third list.
