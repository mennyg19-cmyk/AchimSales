# Preview / local / new Azure Web App only. Never set APP_ENV=production on
# reports.achimonline.com until Menny signs off.
APP_ENV=preview
# Required when APP_ENV=production. Preview may use a local-only default.
# Live Azure also has FLASK_SECRET / FLASK_SECRET_KEY — those names work here too.
SESSION_SECRET=
# FLASK_SECRET=
# Azure Linux App Service sets PORT. Local default is 8000 in startup.sh.
# PORT=8000
# sqlite path. Azure startup.sh defaults to /tmp/homedata/home.sqlite (not /home SMB).
# APP_DB_PATH=
# SharePoint site whose Documents library holds Direct Reports.
# SP_SITE_URL=https://achimonline.sharepoint.com
# Production requires this so home.sqlite is replicated off the box.
# LITESTREAM_AZURE_ACCOUNT_NAME=
# LITESTREAM_AZURE_ACCOUNT_KEY=
# LITESTREAM_AZURE_CONTAINER=
# LITESTREAM_AZURE_PATH=home.sqlite
# Reporting doorway. Empty KEY keeps catalog mock JSON. Never point BASE at reports.achimonline.com.
REPORTING_API_BASE_URL=https://achim-reporting-api-test-hpadbffpcwe0dnga.westus3-01.azurewebsites.net
# REPORTING_API_KEY=

# Graph mail + Entra (same app registration). Leave blank on the Cloudflare dummy.
# Mail also needs EMAIL_FROM / EMAIL_FROM_ADDRESS. Without these, mail stays in sqlite outbox.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# EMAIL_FROM=reports@achimonline.com
# ENTRA_REDIRECT_PATH=/auth/callback
# Clock is on unless DISABLE_SCHEDULE_CLOCK=1 (tests set this via PYTEST_CURRENT_TEST).
# DISABLE_SCHEDULE_CLOCK=
